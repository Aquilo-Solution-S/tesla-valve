import TeslaValve.View
open Lean

/-! What the ledger hands to the code, so a value is written once: each constant as a Rust
macro arm, and each decision as vectors, the answer to every input, which a test replays
against the code that holds it. -/

namespace TeslaValve

/-- A value as a Rust literal, if it has one: a number, a truth value, a string, an array or
an option. A closed choice and a shape have none, as Rust declares its own types. -/
partial def rustLiteral (e : Expr) : Option String :=
  let args := e.getAppArgs
  match e.getAppFn with
  | .const ``Bool.true _ => some "true"
  | .const ``Bool.false _ => some "false"
  | .const ``OfNat.ofNat _ => args[1]? >>= rustLiteral
  | .lit (.natVal n) => some (toString n)
  | .lit (.strVal s) => some s.quote
  | .const ``Option.none _ => some "None"
  | .const ``Option.some _ => (rustLiteral args.back!).map (s!"Some({·})")
  | .const ``List.nil _ => some "[]"
  | .const ``List.cons _ => do
    let items ← (listItems e).mapM rustLiteral
    return s!"[{", ".intercalate items}]"
  | _ => none

/-- Whether a name reads as Rust tokens: identifiers joined by dots. -/
def rustSpells (name : Name) : Bool :=
  name.components.all fun
    | .str _ s => s.front.isAlpha && s.all fun c => c.isAlphanum || c == '_'
    | _ => false

/-- The constants of the ledger, in source order, each with its value reduced. -/
def constants (loaded : Loaded) : IO (Array (Written × Expr)) := do
  let mut found := #[]
  for w in loaded.written do
    if !loaded.modules.contains w.module then continue
    let .defnInfo d := w.info | continue
    if !(arrows d.type).1.isEmpty then continue
    found := found.push (w, ← loaded.meta (Meta.reduce (mkConst w.name)))
  return found

/-- Every constant of the ledger that has a Rust literal, as an arm of the macro `ledger!`:
`ledger!(Shop.Stock.maxPerOrder)` is its value, in whatever type the Rust item gives it. -/
def emitRust (loaded : Loaded) : IO (Except String String) := do
  let mut arms := #[]
  let mut unspelled := #[]
  for (w, value) in ← constants loaded do
    let some literal := rustLiteral value | continue
    if !rustSpells w.name then
      unspelled := unspelled.push w.name
      continue
    let doc ← docOf loaded.env w.name
    arms := arms.push s!"    // {doc}\n    ({w.name}) => \{\n        {literal}\n    };"
  if !unspelled.isEmpty then
    return .error s!"no Rust tokens spell {", ".intercalate (unspelled.toList.map toString)}"
  let header := "// Generated by the ledger's `emit rust`. Each constant of the ledger, by its full name.\n"
  if arms.isEmpty then return .ok header
  return .ok s!"{header}#[macro_export]\nmacro_rules! ledger \{\n{"\n".intercalate arms.toList}\n}\n"

/-- A value as JSON: a case by its name, or as an object of its name and what it carries; a
shape as an object of its fields, without its invariant; an `Except` as `ok` or `error`. -/
partial def toJson (env : Environment) (e : Expr) : Json :=
  let args := e.getAppArgs
  match e.getAppFn with
  | .const ``Bool.true _ => .bool true
  | .const ``Bool.false _ => .bool false
  | .const ``OfNat.ofNat _ => toJson env (args[1]?.getD e)
  | .lit (.natVal n) => .num n
  | .lit (.strVal s) => .str s
  | .const ``Option.none _ => .null
  | .const ``Option.some _ => toJson env args.back!
  | .const ``Except.ok _ => .mkObj [("ok", toJson env args.back!)]
  | .const ``Except.error _ => .mkObj [("error", toJson env args.back!)]
  | .const ``List.nil _ => .arr #[]
  | .const ``List.cons _ => .arr ((listItems e).map (toJson env)).toArray
  | .const ctor _ => match env.find? ctor with
    | some (.ctorInfo info) =>
      let fields := args.extract info.numParams args.size
      let case := match ctor with | .str _ s => s | _ => ctor.toString
      if fields.isEmpty then .str case
      else
        let names := getStructureFields env info.induct
        if names.isEmpty then .mkObj [(case, .arr (fields.map (toJson env)))]
        else .mkObj (((names.toList.zip fields.toList).zip (fieldTypes info.type info.numParams)).filterMap
          fun ((field, v), type) => if type.isAppOf ``Eq then none else some (field.toString, toJson env v))
    | _ => .str (toString e)
  | _ => .str (toString e)

/-- Every decision of the ledger, by its full name, with its answer to each of its inputs. -/
def emitVectors (loaded : Loaded) : IO Json := do
  let mut decisions := #[]
  for w in loaded.written do
    if !loaded.modules.contains w.module then continue
    let .defnInfo d := w.info | continue
    let inputs := (arrows d.type).1.toList
    if inputs.isEmpty then continue
    let mut rows := #[]
    for combination in combinations loaded.env inputs do
      let answer ← loaded.meta (Meta.reduce (mkAppN (mkConst w.name) combination.toArray))
      rows := rows.push (Json.mkObj [
        ("in", .arr (combination.map (toJson loaded.env)).toArray),
        ("out", toJson loaded.env answer)])
    decisions := decisions.push (w.name.toString, Json.arr rows)
  return .mkObj decisions.toList

/-- Prints what `emit rust` or `emit vectors` hands to the code. -/
def emit (config : Config) (target : String) : IO UInt32 := do
  let loaded ← config.load
  match target with
  | "rust" =>
    match ← emitRust loaded with
    | .ok text => IO.print text; return 0
    | .error why => IO.eprintln s!"error: {why}"; return 1
  | "vectors" => IO.println (← emitVectors loaded).pretty; return 0
  | _ => IO.eprintln s!"error: emit {target}: what it emits is rust or vectors"; return 2

end TeslaValve
